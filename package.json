{
  "name": "creatina-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1 --open",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start:server": "node server/index.js",
    "start:neon": "node server/index-neon.js"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "multer": "^2.0.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
